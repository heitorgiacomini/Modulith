{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum by (service_name, severity) (count_over_time({log_type=\"application\",environment=~\"$environment\",service_name=~\"$service\",severity=~\"$severity\"} |~ \"(?i)$search\" [$__auto]))", "legendFormat": "{{service_name}} {{severity}}", "queryType": "range", "refId": "A"}],
      "title": "Events by service and severity",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 7},
      "id": 2,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"expr": "{log_type=\"application\",environment=~\"$environment\",service_name=~\"$service\",severity=~\"$severity\"} | json | route=~\"$route\" | status=~\"$status\" | trace_id=~\"$trace\" |~ \"(?i)$search\"", "queryType": "range", "refId": "A"}],
      "title": "Application logs",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["eshop", "logs"],
  "templating": {"list": [
    {"current": {"text": "All", "value": "$__all"}, "datasource": {"type": "loki", "uid": "loki"}, "includeAll": true, "label": "Environment", "multi": true, "name": "environment", "query": "label_values({log_type=\"application\"}, environment)", "refresh": 1, "type": "query"},
    {"current": {"text": "All", "value": "$__all"}, "datasource": {"type": "loki", "uid": "loki"}, "includeAll": true, "label": "Service", "multi": true, "name": "service", "query": "label_values({log_type=\"application\"}, service_name)", "refresh": 1, "type": "query"},
    {"current": {"text": "All", "value": "$__all"}, "datasource": {"type": "loki", "uid": "loki"}, "includeAll": true, "label": "Severity", "multi": true, "name": "severity", "query": "label_values({log_type=\"application\"}, severity)", "refresh": 1, "type": "query"},
    {"current": {"text": ".*", "value": ".*"}, "label": "Route", "name": "route", "query": ".*", "type": "textbox"},
    {"current": {"text": ".*", "value": ".*"}, "label": "Status", "name": "status", "query": ".*", "type": "textbox"},
    {"current": {"text": ".*", "value": ".*"}, "label": "Trace ID", "name": "trace", "query": ".*", "type": "textbox"},
    {"current": {"text": ".*", "value": ".*"}, "label": "Text", "name": "search", "query": ".*", "type": "textbox"}
  ]},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "EShop Event / Log Explorer",
  "uid": "eshop-event-explorer",
  "version": 1
}
