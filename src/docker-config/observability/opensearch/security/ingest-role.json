{
  "cluster_permissions": [
    "cluster_monitor",
    "cluster_composite_ops"
  ],
  "index_permissions": [
    {
      "index_patterns": [
        "eshop-app-logs-*",
        "eshop-app-metrics-*",
        "eshop-audit-*",
        "otel-v1-apm-span-*"
