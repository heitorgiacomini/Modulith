{
  "index_patterns": ["eshop-app-metrics-*"],
  "order": 1100,
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "plugins.index_state_management.policy_id": "eshop-metrics-30d"
  },
  "mappings": {
    "dynamic": true,
    "properties": {
      "time": { "type": "date" },
      "startTime": { "type": "date" },
      "name": { "type": "keyword" },
      "unit": { "type": "keyword" },
      "kind": { "type": "keyword" },
      "value": { "type": "double" },
      "sum": { "type": "double" },
      "count": { "type": "long" },
      "min": { "type": "double" },
      "max": { "type": "double" },
      "resource": { "type": "object", "dynamic": true },
      "attributes": { "type": "object", "dynamic": true }
    }
  }
}
