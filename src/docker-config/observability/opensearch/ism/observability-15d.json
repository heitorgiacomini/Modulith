{
  "policy": {
    "description": "Delete Eshop application logs and trace spans after 15 days.",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          { "state_name": "delete", "conditions": { "min_index_age": "15d" } }
        ]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ],
    "ism_template": [
      { "index_patterns": ["eshop-app-logs-*", "otel-v1-apm-span-*"], "priority": 100 }
    ]
  }
}
