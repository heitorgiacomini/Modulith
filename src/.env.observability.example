# Copy this file to .env before running Compose.
# Replace the username, password, and public URL for every deployment.
GRAFANA_ADMIN_USER=observability-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_ROOT_URL=https://observability.example.com

# Linux VPS: use the numeric GID reported by `getent group docker`.
# Docker Desktop: its Linux VM socket is normally root:root, so use 0.
DOCKER_GID=999

ASPNETCORE_ENVIRONMENT=Production
DEPLOYMENT_ENVIRONMENT=Production

# Errors and traces lasting at least two seconds are retained independently.
# Use 100 while validating; lower this baseline percentage in production.
OTEL_TAIL_SAMPLING_PERCENTAGE=10
