{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Fusion": {
    "SchemaPath": "gateway.far"
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Keycloak": {
    "realm": "eshoprealm",
    "auth-server-url": "http://localhost:9090/",
    "public-issuer": "http://localhost:9090/realms/eshoprealm",
    "ssl-required": "none",
    "resource": "myclient",
    "verify-token-audience": false,
    "credentials": {
      "secret": ""
    },
    "confidential-port": 0
  }
}
