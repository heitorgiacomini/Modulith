{
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5434;Database=eshopdb;User Id=eshopdb;Password=eshopdb;Include Error Detail=true",
    "Databases":"Server=localhost;Port=5432;Database=eshopdb;User Id=eshopdb;Password=eshopdb;Include Error Detail=true",
    "Redis": "localhost:6379"
  },
  "MessageBroker": {
    "Host": "amqp://localhost:5672",
    "UserName": "eshopdb",
    "Password": "eshopdb"
  },
  "Keycloak": {
    "realm": "eshoprealm",
    "auth-server-url": "http://localhost:9090/",
    "public-issuer": "http://localhost:9090/realms/eshoprealm",
    "ssl-required": "none",
    "resource": "myclient",
    "verify-token-audience": false,
    "credentials": {
      "secret": ""
    },
    "confidential-port": 0
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "OpenTelemetry": {
    "ServiceName": "eshop-api",
    "ExportLogs": true
  },
  "AuditTrail": {
    "DirectoryPath": "logs/audit",
    "FileNamePrefix": "eshop-audit",
    "MaxFileSizeBytes": 134217728,
    "RetainedFileCount": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*"
}
