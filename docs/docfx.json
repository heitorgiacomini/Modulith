{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/Bootstrapper/Api/Api.csproj"
          ],
          "exclude": [
            "**/obj/**",
            "**/bin/**"
          ]
        }
      ],
      "dest": "api/Bootstrapper",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "monikerRange": "bootstrapper"
    },
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/Shared/Shared/Shared.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        }
      ],
      "dest": "api/Shared",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "monikerRange": "shared"
    }
  ],
  "build": {
    "template": [
      "default",
      "modern",
      "templates"
    ],
    "content": [
      {
        "src": "..",
        "files": [
          "src/Modules/module.md",
          "src/Shared/shared.md",
          "src/docker-config/observability/README.md"
        ],
        "dest": "reference"
      },
      {
        "files": [
          "*.md",
          "toc.yml"
        ]
      },
      {
        "files": [
          "api/**.yml",
          "api/**.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "src": "..",
        "files": [
          "ModularMonolithArchitecture.png",
          "ModularMonolithArchitecture.svg",
          "ModuleBoundaries&Ownership.png",
          "ModuleBoundaries&Ownership.svg",
          "image.png",
          "architecture.svg"
        ],
        "dest": "reference"
      },
      {
        "files": [
          "styles/**",
          "images/**",
          "index.html"
        ],
        "exclude": ["images/**.old.png", "images/**.old.svg"]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "ESHOP",
      "_appFooter": "© 2026 Eshop. All rights reserved.",
      "_disableContribution": false,
      "_appFaviconPath": "images/eshop-logo.png",
      "_appLogoPath": "images/eshop-logo.png",
      "_enableSearch": true
    },
    "styles": [
      "styles/override.css"
    ]
  }
}
